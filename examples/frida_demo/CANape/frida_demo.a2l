			/* compilation unit = 0, function = main, CFA = 0 */
			/begin EVENT "mainloop" "mainloop" 2 DAQ 0xFF 0 0 0 CONSISTENCY DAQ /end EVENT

		/end DAQ

		/begin XCP_ON_UDP_IP 0x0104 5555 ADDRESS "192.168.8.135" /end XCP_ON_UDP_IP

/end IF_DATA


